pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',url: 'https://github.com/horek2503/AQA_python.git'
            }
        }
        stage('Install python') {
            steps {
                sh '''#!/bin/bash
                    apt-get update
                    apt-get install -y python3 python3-dev
                    apt install -y python3-pip
                    apt install -y python3.13-venv
                    python3 -m venv venv'''            }
        }
        stage('Install requirements') {
            steps {
                sh '''#!/bin/bash
                    source venv/bin/activate
                    pip install -r requirements.txt
                    playwright install --with-deps'''
            }
        }
        stage('Clean old results and run tests') {
            steps {
                sh '''#!/bin/bash
                    rm -rf allure-files
                    rm -rf allure-report
                    source venv/bin/activate
                    pytest -m ui --alluredir=allure-results'''
            }
        }
    }
    post {
            always {
                allure commandline: 'Allure', includeProperties: false, jdk: '', resultPolicy: 'LEAVE_AS_IS', results: [[path: 'allure-results']]
            }
        }
}